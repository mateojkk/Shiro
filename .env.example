# ==========================================
# Shiro Protocol — Environment Configuration
# ==========================================

# Network RPCs (X Layer)
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
CHAIN_ID=1952

# Deployer / Keeper Private Key (for contract deployment & keeper execution)
PRIVATE_KEY=your_deployer_private_key_without_quotes
KEEPER_PRIVATE_KEY=your_keeper_private_key_without_quotes
KEEPER_ADDRESS=your_keeper_executor_address

# DEX router addresses
OKX_DEX_ROUTER=0x7c5bee2a8091c3ef39072f64f18fac913060aeaf
QUICKSWAP_ROUTER=0x4B9f4d2435Ef65559567e5DbFC1BbB37abC43B57

# Token addresses used for live deployments
USDC_ADDRESS=0x74b7f16337b8972027f6196a17a631ac6de26d22
WETH_ADDRESS=0x5a77f1443d16ee5761d310e38b62f77f726bc71c
USDT_ADDRESS=0x1E4a5963aBFD975d8c9021ce480b42188849D41d

# OKLink Explorer API Key (optional for verification)
OKLINK_API_KEY=your_oklink_api_key_here

# Groq AI Inference Engine (Llama-3.3-70B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OKX DEX Aggregator API (v6)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Deployed Contract Addresses on X Layer
SHIRO_VAULT_ADDRESS=your_shiro_vault_address
SHIRO_ROUTER_ADDRESS=your_shiro_router_address
SHIRO_DCA_ADDRESS=your_shiro_dca_address
