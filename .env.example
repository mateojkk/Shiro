# ==============================================================
# Shiro Protocol — Environment Configuration (Vercel & Local)
# ==============================================================

# Network Configuration (X Layer Mainnet)
NEXT_PUBLIC_CHAIN_ID=196
NEXT_PUBLIC_XLAYER_RPC=https://rpc.xlayer.tech

# Groq AI LPU Inference Engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OKX DEX Aggregator API Credentials (Optional - Fallbacks to Direct Canonical DEX Router)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_PROJECT_ID=your_okx_project_id_here

# Smart Contract Deployer (Only required for CLI contract deployments)
PRIVATE_KEY=your_deployer_private_key_without_quotes
OKLINK_API_KEY=your_oklink_api_key_here
